# Ambiente local (npm start). Na nuvem estes valores vem do SSM e do Terraform.
PORT=3000
# Postgres local ou o Neon
DB_URL=postgresql://postgres:postgres@localhost:5432/rededementores
JWT_KEY=troque-por-um-segredo-local
EXPIRES_IN=1d
# Sem FILES_BUCKET as imagens vao para assets/userImages e saem em /files
# FILES_BUCKET=
# Envio de e-mail (Gmail SMTP); desligado por padrao
EMAIL_ENABLED=false
# EMAIL_ACCOUNT=
# EMAIL_PASSWORD=
# ROOT_URL=localhost:8080
