# Copie para terraform.tfvars (ignorado pelo git) e preencha.

# Connection string do projeto no Neon (Dashboard > Connect). Para a Lambda,
# prefira o endpoint com "-pooler": cada container abre conexoes proprias e o
# pooler do Neon aguenta muitas mais que o endpoint direto.
db_conn_string = "postgresql://usuario:senha@ep-exemplo-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Opcional: e-mail pelo Gmail (recuperacao de senha e avisos de mentoria).
# Conta com verificacao em 2 etapas + senha de app em
# https://myaccount.google.com/apppasswords. Ao trocar, incremente
# secrets_version em variables.tf.
# email_account  = "projeto@gmail.com"
# email_password = "abcdabcdabcdabcd"
