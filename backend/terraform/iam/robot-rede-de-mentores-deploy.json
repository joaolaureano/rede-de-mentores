{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RoleComBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::019593222321:role/rede-de-mentores-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::019593222321:policy/robot-ec2-boundary"
        }
      }
    },
    {
      "Sid": "RoleManutencao",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::019593222321:role/rede-de-mentores-*"
    },
    {
      "Sid": "PassRoleSoParaLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::019593222321:role/rede-de-mentores-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "Lambda",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:us-east-1:019593222321:function:rede-de-mentores-*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:StartLiveTail"
      ],
      "Resource": "arn:aws:logs:us-east-1:019593222321:log-group:/aws/lambda/rede-de-mentores-*"
    },
    {
      "Sid": "LogsDescribe",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "S3Buckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::rede-de-mentores-site-019593222321",
        "arn:aws:s3:::rede-de-mentores-site-019593222321/*",
        "arn:aws:s3:::rede-de-mentores-files-019593222321",
        "arn:aws:s3:::rede-de-mentores-files-019593222321/*"
      ]
    },
    {
      "Sid": "SsmSegredos",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:us-east-1:019593222321:parameter/rede-de-mentores/*"
    },
    {
      "Sid": "SsmDescribe",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*"
    },
    {
      "Sid": "CloudFrontFunction",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateFunction",
        "cloudfront:DescribeFunction",
        "cloudfront:GetFunction",
        "cloudfront:UpdateFunction",
        "cloudfront:PublishFunction",
        "cloudfront:DeleteFunction"
      ],
      "Resource": "arn:aws:cloudfront::019593222321:function/rede-de-mentores-*"
    },
    {
      "Sid": "CloudFrontDistribuicaoCriar",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:TagResource"
      ],
      "Resource": "arn:aws:cloudfront::019593222321:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "rede-de-mentores"
        }
      }
    },
    {
      "Sid": "CloudFrontDistribuicaoGerir",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:ListTagsForResource",
        "cloudfront:UntagResource",
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::019593222321:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "rede-de-mentores"
        }
      }
    },
    {
      "Sid": "CloudFrontOacEPoliticas",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetOriginAccessControlConfig",
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl",
        "cloudfront:ListOriginAccessControls",
        "cloudfront:ListCachePolicies",
        "cloudfront:GetCachePolicy",
        "cloudfront:ListOriginRequestPolicies",
        "cloudfront:GetOriginRequestPolicy"
      ],
      "Resource": "*"
    }
  ]
}